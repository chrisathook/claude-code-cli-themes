  ],
  "keywords": [
    "theme",
    "color-theme",
    "colorblind",
    "accessibility",
    "deutan",
    "cvd",
    "dark",
    "light"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Deutan Dark",
        "uiTheme": "vs-dark",
